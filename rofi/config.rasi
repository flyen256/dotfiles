configuration {
    font: "JetBrains Mono Bold 14";
    show-icons: true;
    terminal: "ghostty";
    disable-history: false;
    drun {
        display-name: " ";
    }
    run {
        display-name: " ";
    }
    timeout {
        delay: 20;
        action: "kb-cancel";
    }
}

@import "./colors.rasi"

window {
    background-color: @background;
    border:           2;
    border-radius:    15;
    border-color:     @border;
    padding:          15;
    width: 400px;
    height: 385px;
}
mainbox {
    border:  0;
    spacing: 10;
}
message {
    border:       0px;
    border-color: @active;
}
textbox {
    text-color: @foreground;
}
listview {
    fixed-height: 0;
    border:       0px;
    border-color: @border;
    spacing:      5px;
    scrollbar:    false;
}
element {
    border:           0;
    padding: 5px;
    background-color: @background-item;
    border-radius:    10;
} element.normal.normal {
    background-color: @background-item;
    text-color:       @foreground;
    border-radius:    10;
}
element.normal.active {
    border:           2;
    background-color: @background-item;
    border-radius:    10;
    border-color:     @active;
    text-color:       @foreground;
}
element.selected.normal {
    border:           2;
    border-radius:    10;
    background-color: @background-active;
    border-color:     @active;
    text-color:       @selected-text;
}
element.alternate.normal {
    border-radius:    10;
    background-color: @background-item;
    text-color:       @foreground;
}
scrollbar {
    background-color: @foreground;
    handle-color:   @selected-text;
    border-radius:  0px;
    width:          2px ;
    border:         0;
    handle-width:   8px ;
    padding:        0;
}
sidebar {
    border:       2px dash 0px 0px ;
    border-color: @active;
}
button.selected {
    background-color: inherit;
    text-color:       @foreground;
}
inputbar {
    spacing:    0;
    text-color: @selected-text;
    padding:    5px 10px;
    children:   [ entry,case-indicator ];
    background-color: @background-item;
    border: 0;
    border-radius: 10px;
}
case-indicator {
    spacing:    0;
    text-color: @selected-text;
}
entry {
    placeholder: "Search..";
    placeholder-color: @foreground-secondary;
    text-color: @foreground-secondary;
}
prompt {
    spacing:    0;
    text-color: @selected-text;
}
element {
    spacing: 0.5em;
}
element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
}
element-icon {
    size: 1.4em;
}
textbox-prompt-colon {
    expand:     false;
    str:        " │ ";
    margin:     0px 0.3em 0em 0em ;
    text-color: @foreground;
}
